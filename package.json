{
    "name": "pos-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "serve": "vite",
        "start": "vite",
        "composer:mailgun": "composer require symfony/http-client symfony/mailgun-mailer",
        "artisan:config-refresh": "php artisan config:clear && php artisan cache:clear && php artisan config:cache",
        "postinstall": "npm run composer:mailgun && npm run artisan:config-refresh"
    },
    "dependencies": {
        "axios": "^1.12.2",
        "echarts": "^5.6.0",
        "jsbarcode": "^3.12.1",
        "jspdf": "^3.0.3",
        "pinia": "^3.0.3",
        "vue": "^3.5.22",
        "vue-echarts": "^6.7.3",
        "vue-router": "^4.6.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.15",
        "@tailwindcss/vite": "^4.1.15",
        "@types/echarts": "^4.9.22",
        "@types/node": "^24.9.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/tsconfig": "^0.8.1",
        "autoprefixer": "^10.4.21",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.1",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.15",
        "typescript": "~5.9.3",
        "vite": "^7.2.0",
        "vue-tsc": "^3.1.0"
    }
}
